{
  "name": "react-x2-native-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "React Native components library with modern UI patterns for Android and iOS",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --parallel lint",
    "format": "pnpm -r --parallel format",
    "type-check": "pnpm -r type-check",
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest-expo": "~57.0.2",
    "prettier": "^3.1.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@8.15.0"
}
