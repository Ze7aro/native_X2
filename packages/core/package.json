{
  "name": "@react-x2-native/core",
  "version": "0.1.0",
  "description": "Core utilities for react-x2-native",
  "main": "dist/index.js",
  "react-native": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "type-check": "tsc -b",
    "dev": "tsc -b --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.80.0",
    "react-native-safe-area-context": ">=5.0.0"
  },
  "dependencies": {
    "@react-x2-native/tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "typescript": "~6.0.3"
  }
}
